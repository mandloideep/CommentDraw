# Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose at the repo root.

# ---------- MySQL (consumed by the `mysql` service and the backend) ----------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=commentdraw
MYSQL_USER=commentdraw
MYSQL_PASSWORD=commentdrawpass

# ---------- Backend datasource ----------
# Hostname `mysql` resolves to the compose service. Change to `localhost` if running outside docker.
DB_URL=jdbc:mysql://mysql:3306/commentdraw?useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=commentdraw
DB_PASSWORD=commentdrawpass

# ---------- Redis ----------
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# ---------- JWT ----------
# Must be a Base64-encoded key (Decoders.BASE64.decode is called on it).
# Generate one with: openssl rand -base64 48
SECRET_KEY=replace-with-base64-encoded-secret

# ---------- Frontend URLs (used by backend for CORS / redirects / email links) ----------
FRONTEND_BASE_URL=http://localhost:5571
APP_FRONTEND_AUTH_SUCCESS_URL=http://localhost:5571/auth-success

# ---------- Google OAuth ----------
# Custom OAuth flow (NOT Spring's auto-configured OAuth2 Login). The redirect URI
# must point to GoogleAuthController's /auth/google/callback endpoint, and the
# SAME URI must be added to "Authorized redirect URIs" in your Google Cloud OAuth client.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# ---------- YouTube Data API ----------
YOUTUBE_API_KEY=your-youtube-data-api-key

# ---------- Email (Brevo REST API) ----------
# This app uses Brevo's REST API (not SMTP), so the API key alone authenticates requests.
# EMAIL_USERNAME is misnamed — it's actually the SENDER "from" email address used in the
# API payload (sender.email). Must be a VERIFIED sender on your Brevo account.
EMAIL_USERNAME=comment-draw@mail.deepmandloi.com
BREVO_API_KEY=your-brevo-api-key

# ---------- Stripe ----------
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Get from `stripe listen --forward-to localhost:8080/api/webhooks/stripe` or the dashboard webhook config
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Stripe Price IDs (one per paid plan in SubscriptionTypes enum)
STRIPE_PRICE_ID_GOLD=price_your-gold-price-id
STRIPE_PRICE_ID_DIAMOND=price_your-diamond-price-id

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------- Frontend (Vite, read via import.meta.env) ----------
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id
# Must match GOOGLE_REDIRECT_URI above — the frontend uses this when building the
# Google OAuth URL, so the value the browser sends to Google must be byte-identical
# to what the backend expects (and to what's registered in Google Cloud Console).
VITE_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# Stripe publishable key is only required if you embed Stripe.js Elements.
# The hosted Checkout redirect flow used here does NOT need it.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
